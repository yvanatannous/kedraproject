# Dagster control-plane image shared by the webserver and daemon. User code is
# intentionally kept in Dockerfile_user_code, as recommended by Dagster's
# Docker deployment guide.
FROM python:3.10-slim

ARG DAGSTER_VERSION=1.13.21
ARG DAGSTER_LIBRARY_VERSION=0.29.21

RUN pip install --no-cache-dir \
    "dagster==${DAGSTER_VERSION}" \
    "dagster-graphql==${DAGSTER_VERSION}" \
    "dagster-webserver==${DAGSTER_VERSION}" \
    "dagster-postgres==${DAGSTER_LIBRARY_VERSION}" \
    "dagster-docker==${DAGSTER_LIBRARY_VERSION}"

ENV DAGSTER_HOME=/opt/dagster/dagster_home/

RUN mkdir -p "$DAGSTER_HOME"

COPY dagster.yaml workspace.yaml "$DAGSTER_HOME"

WORKDIR $DAGSTER_HOME
