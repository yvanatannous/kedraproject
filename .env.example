# Dagster metadata database
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_HOST=dagster_postgresql
DAGSTER_WEB_PORT=3000

# Scraper metadata database
MONGO_URI=mongodb://mongodb:27017
MONGO_DATABASE=kedrascraper
MONGO_COLLECTION=decisions
MONGO_CURATED_COLLECTION=decisions_curated
MONGO_PORT=27017

# Landing/curated object storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=decisions
MINIO_CURATED_BUCKET=curated
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application settings
DISABLE_SCRAPY_LOGS=false
PARTITION_SIZE=1m